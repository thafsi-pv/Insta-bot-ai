# ── Database (Render PostgreSQL / Supabase / Neon) ──────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/insta_bot_db?schema=public"

# ── Redis ────────────────────────────────────────────────────────────────────
# Option A: Upstash Redis (production) – use rediss:// TLS URL
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379"

# Option B: Local Redis (development only)
# REDIS_HOST="localhost"
# REDIS_PORT=6379

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET="your-very-secure-jwt-secret-min-32-chars"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="32-character-secret-encryption-key!!"

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── Instagram / Meta App ─────────────────────────────────────────────────────
INSTAGRAM_APP_ID="your-meta-app-id"
INSTAGRAM_APP_SECRET="your-meta-app-secret"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your-webhook-verify-token"
# Set to your Render backend URL after deploy:
INSTAGRAM_REDIRECT_URI="https://your-backend.onrender.com/instagram/callback"

# ── Frontend URL (CORS whitelist) ─────────────────────────────────────────────
# Comma-separated if you have preview + production URLs
FRONTEND_URL="https://your-app.vercel.app"

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
